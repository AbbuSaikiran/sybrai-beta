# SYBRAI AI Model Configuration
# Choose your AI provider: 'gemini' (default) or 'openai' or 'custom'
VITE_AI_PROVIDER=gemini

# Recommended Gemini Models:
# - gemini-1.5-flash (Fast & lightweight, recommended for mobile alerts)
# - gemini-2.0-flash (Next-gen speed and reasoning)
# - gemini-1.5-pro (High capability for complex code debugging)
VITE_AI_MODEL=gemini-1.5-flash

# Paste your Gemini API Key from Google AI Studio (https://aistudio.google.com/app/apikey)
# OR your OpenAI API Key if using provider=openai
VITE_AI_API_KEY=your_api_key_here

# Optional: Custom API Base URL (if using a proxy or Ollama / OpenAI-compatible endpoint)
# VITE_AI_BASE_URL=https://api.openai.com/v1
